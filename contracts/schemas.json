{
  "schema": "lekalo/contract-rules/v1",
  "requires": [
    "validation.schemas/v1"
  ],
  "bindings": {
    "typescript.exported-factories/v1": {
      "capability": "validation.schemas/v1",
      "module": "zod",
      "export": "z",
      "fact": "schemas",
      "member": "object"
    }
  },
  "checks": [
    {
      "id": "exported-schema",
      "schema": {
        "type": "object",
        "required": [
          "schemas"
        ],
        "properties": {
          "schemas": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "name",
                "path"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  ]
}
